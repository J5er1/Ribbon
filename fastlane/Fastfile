default_platform(:ios)

platform :ios do
  desc "Build the app and upload a new build to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      api_key: api_key
    )

    latest_build = latest_testflight_build_number(api_key: api_key)
    increment_build_number(build_number: latest_build + 1)

    build_app(
      scheme: "Ribbon",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          (ENV["APP_IDENTIFIER"] || "bible.ribbon.app") => "match AppStore #{ENV['APP_IDENTIFIER'] || 'bible.ribbon.app'}"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
