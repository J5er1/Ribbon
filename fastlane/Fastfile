default_platform(:ios)

# Paths are relative to the repo root: fastlane is invoked from there
# (`bundle exec fastlane beta`), not from inside fastlane/.
XCODEPROJ = "ios/Ribbon.xcodeproj"
SCHEME = "Ribbon"

platform :ios do
  desc "Build the app and upload a new build to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    match(
      type: "appstore",
      api_key: api_key
    )

    latest_build = latest_testflight_build_number(api_key: api_key)
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest_build + 1
    )

    profile_specifier = "match AppStore #{ENV['APP_IDENTIFIER'] || 'bible.ribbon.app'}"

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          (ENV["APP_IDENTIFIER"] || "bible.ribbon.app") => profile_specifier
        }
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}",
        "PROVISIONING_PROFILE_SPECIFIER='#{profile_specifier}'"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
