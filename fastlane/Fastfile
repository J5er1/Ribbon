default_platform(:ios)

# Paths are relative to the repo root: fastlane is invoked from there
# (`bundle exec fastlane beta`), not from inside fastlane/.
XCODEPROJ = "ios/Ribbon.xcodeproj"
SCHEME = "Ribbon"

platform :ios do
  desc "Build the app and upload a new build to TestFlight"
  lane :beta do
    setup_ci if ENV["CI"]

    key_id = ENV["ASC_KEY_ID"].to_s.strip
    raw_key = ENV["ASC_KEY_CONTENT"].to_s.strip

    if key_id.empty? || raw_key.empty?
      UI.user_error!("App Store Connect API key secrets (ASC_KEY_ID, ASC_KEY_CONTENT) are not set in GitHub repository secrets.")
    end

    decoded_key = begin
      require "base64"
      decoded = Base64.decode64(raw_key)
      decoded.include?("BEGIN") ? decoded : raw_key
    rescue
      raw_key
    end
    normalized_key = decoded_key.gsub('\n', "\n").strip

    key_path = File.expand_path("AuthKey_#{key_id}.p8")
    File.write(key_path, normalized_key + "\n")

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path
    )

    # Two things are signed now: the app, and the widget extension it carries
    # (S24). Each needs its own App Store profile, and both App IDs need the
    # capabilities their entitlements ask for — Push Notifications and the
    # App Group on the app, the App Group on the widget. After turning those
    # on in the developer portal, run the TestFlight workflow once with
    # "refresh profiles" ticked so match makes the profiles again with them.
    app_identifier = ENV["APP_IDENTIFIER"] || "bible.ribbon.app"
    targets = {
      "Ribbon" => app_identifier,
      "RibbonWidgets" => "#{app_identifier}.widgets"
    }

    match(
      type: "appstore",
      app_identifier: targets.values,
      api_key: api_key,
      force: ENV["MATCH_FORCE"] == "true"
    )

    latest_build = latest_testflight_build_number(api_key: api_key)
    increment_build_number(
      xcodeproj: XCODEPROJ,
      build_number: latest_build + 1
    )

    # Each target signed with its own profile. A profile named on the command
    # line would apply to every target at once, and the widget cannot be
    # signed with the app's; so the names go into each target's own settings
    # in this checkout instead.
    targets.each do |target, identifier|
      update_code_signing_settings(
        path: XCODEPROJ,
        use_automatic_signing: false,
        targets: [target],
        team_id: ENV["TEAM_ID"],
        bundle_identifier: identifier,
        profile_name: "match AppStore #{identifier}"
      )
    end

    build_app(
      project: XCODEPROJ,
      scheme: SCHEME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: targets.values.to_h { |identifier| [identifier, "match AppStore #{identifier}"] }
      },
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{ENV['TEAM_ID']}"
      ].join(" ")
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
