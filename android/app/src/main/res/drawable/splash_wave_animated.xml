<?xml version="1.0" encoding="utf-8"?>
<!-- The splash mark. Two targets on one drawable: the clip band opens, and
     the whole group settles out of a very slight overscale.

     The group is `wave` and the clip is `unfurl`, named in splash_wave.xml —
     an animated-vector target that does not match a name in its vector is
     not an error, it is an animation that silently does not play. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_wave">
    <target android:name="unfurl" android:animation="@animator/splash_unfurl" />
    <target android:name="wave" android:animation="@animator/splash_settle" />
</animated-vector>
