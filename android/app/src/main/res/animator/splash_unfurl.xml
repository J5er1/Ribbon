<?xml version="1.0" encoding="utf-8"?>
<!-- The ribbon coming down. The clip band opens from nothing to the mark's
     full 64-unit height; both path states are the same four-command
     rectangle, which is what a path-data morph requires.

     Eased out rather than in-out: a ribbon let out of a book falls quickly
     and settles, it does not accelerate. This is §9.1's arrive shape, and
     440 ms is the same register as the mark's hold in onboarding. -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:propertyName="pathData"
    android:valueFrom="M0,0 L64,0 L64,0 L0,0 Z"
    android:valueTo="M0,0 L64,0 L64,64 L0,64 Z"
    android:valueType="pathType"
    android:duration="440"
    android:interpolator="@android:interpolator/decelerate_quint" />
