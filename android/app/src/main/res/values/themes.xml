<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark is the product (§12): there is no light variant to fall back to.
         The window paints the unlit ground so the very first frame, before
         Compose draws, is already Ribbon's ground and not a white flash. -->
    <style name="Theme.Ribbon" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/unlit</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- The launch window.

         §05 says there is no splash screen, and that rule is kept in the
         sense that matters: nothing is *inserted*. Android 12 and later show
         a system splash on every cold start whether an app asks for one or
         not — it cannot be declined, only styled — so the choice was never
         "splash or no splash", it was "our mark or the launcher icon on a
         grey plate". Owner's call (deviation A28): it is the Wave, on the
         unlit ground, unfurling.

         What is deliberately absent: no wordmark, no tagline, no version, no
         "welcome back". The mark and the ground, and then the room. -->
    <style name="Theme.Ribbon.Splash" parent="Theme.SplashScreen">
        <!-- **The `android:` prefix is the whole thing.** These were the
             androidx compat attributes and the mark never animated, because
             on API 31 and later the *platform* draws the splash from its own
             `android:windowSplashScreen*` attributes and never reads the
             library's. The compat ones only do anything below 31, and this
             app's minSdk is 33 — so every device on earth was falling
             through to the system default: the launcher icon on a plate,
             with the animated vector sitting in the APK unused.

             Because minSdk is already past 31 these live here rather than in
             a values-v31 folder; there is no device that would read a
             pre-31 variant. -->
        <item name="android:windowSplashScreenBackground">@color/unlit</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_wave_animated</item>
        <!-- The system caps this at one second and treats it as a hint. The
             real length of the splash is how long the store takes to come off
             disk; this only tells the platform how long the drawable wants. -->
        <item name="android:windowSplashScreenAnimationDuration">600</item>
        <!-- No icon background: the mark is a shape on a ground, and a
             circular plate behind it would be an app icon rather than a mark.
             Without one the icon is not masked.

             `postSplashScreenTheme` stays a compat attribute — it is the
             library's own, read by `installSplashScreen()` rather than by the
             platform, and it is what swaps the window over to Theme.Ribbon
             once the splash is done. -->
        <item name="postSplashScreenTheme">@style/Theme.Ribbon</item>
    </style>
</resources>
