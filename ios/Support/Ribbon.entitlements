<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Invite links (readribbon.app/i/<token>) open the app when it's
	     installed. The site serves the matching
	     /.well-known/apple-app-site-association (web/build.mjs). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:readribbon.app</string>
		<!-- Passkeys (§6.10). A passkey is bound to the domain it was made
		     against, and the domain has to agree: the site serves a
		     `webcredentials` section in the same
		     /.well-known/apple-app-site-association (web/build.mjs), and the
		     project's WebAuthn relying party is this same bare domain. -->
		<string>webcredentials:readribbon.app</string>
	</array>
</dict>
</plist>
