<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (S19). "development" here is what a build run from Xcode
	     signs with; exporting for TestFlight and the store re-signs it as
	     "production" from the App Store profile, which is why the app says
	     which APNs world its token belongs to (Push.environment). The App ID
	     needs the Push Notifications capability for either. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- The widgets' shared shelf (S24): the room's fire and the faces the
	     Live Activity draws, written by the app and read by the extension.
	     The group has to exist in the developer portal, on both App IDs. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.bible.ribbon.app</string>
	</array>
	<!-- Invite links (readribbon.app/i/<token>) open the app when it's
	     installed. The site serves the matching
	     /.well-known/apple-app-site-association (web/build.mjs). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:readribbon.app</string>
		<!-- Passkeys (§6.10). A passkey is bound to the domain it was made
		     against, and the domain has to agree: the site serves a
		     `webcredentials` section in the same
		     /.well-known/apple-app-site-association (web/build.mjs), and the
		     project's WebAuthn relying party is this same bare domain. -->
		<string>webcredentials:readribbon.app</string>
	</array>
</dict>
</plist>
