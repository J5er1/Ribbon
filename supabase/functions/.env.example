# Secrets for the send-email auth hook. Copy to .env (git-ignored), fill in,
# and push with:
#
#   supabase secrets set --env-file supabase/functions/.env
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by the platform —
# do not set them here.

# Required. From the dashboard: Authentication → Hooks → Generate Secret.
# This is the whole of the hook's authentication: verify_jwt is off (the hook
# fires before any JWT exists), so the Standard Webhooks signature is what
# proves a request came from GoTrue. The function refuses to start without it.
SEND_EMAIL_HOOK_SECRET="v1,whsec_"

# Required. The mail host the hook speaks SMTP to, and the address the code
# arrives from. Port 587 connects in the clear and upgrades with STARTTLS;
# 465 is implicit TLS. Port 25 is refused outright — it is plaintext by
# convention and blocked by most hosts anyway.
#
# The same names appear in config.toml's [auth.email.smtp], which is the
# fallback GoTrue would use if the hook were ever switched off. Same
# credentials, two stores: these are function secrets, those are read from
# the CLI's environment.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SEND_EMAIL_FROM="Ribbon <hello@example.com>"

# Optional. How long to wait on the mail host before giving up and letting
# GoTrue retry. The hook's whole invocation has about five seconds.
SMTP_TIMEOUT_MS=3500

# Recommended. Salts the digest the per-address cooldown counts against, so
# that table is a list of opaque keys rather than a second copy of who uses
# Ribbon. Any long random string; changing it resets everyone's window once.
#   openssl rand -hex 32
EMAIL_THROTTLE_PEPPER=

# Optional — the cooldown itself. Defaults shown.
EMAIL_MAX_PER_HOUR=6
EMAIL_MIN_INTERVAL_SECONDS=60

# Optional. Mirrors auth.email.otp_expiry from config.toml, for the line in
# the mail that says how long the code is good for.
OTP_EXPIRY_MINUTES=10
